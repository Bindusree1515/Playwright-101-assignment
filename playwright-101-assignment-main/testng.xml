<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Two <test> blocks = two browser/OS combinations, run in parallel by TestNG.
  This satisfies the assignment's requirement to execute on at least 2 different
  browser/OS combinations on the TestMu AI platform (Windows 10/Chromium and
  macOS Ventura/WebKit).
-->
<suite name="Playwright101Suite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="com.testmuai.base.RetryTransformer"/>
    </listeners>

    <test name="Windows10-Chromium">
        <parameter name="browserName" value="pw-chromium"/>
        <parameter name="browserVersion" value="latest"/>
        <parameter name="platform" value="Windows 10"/>
        <parameter name="testName" value="Playwright101 - Windows 10 - Chromium"/>
        <classes>
            <class name="com.testmuai.tests.Scenario1SimpleFormDemoTest"/>
            <class name="com.testmuai.tests.Scenario2DragDropSlidersTest"/>
            <class name="com.testmuai.tests.Scenario3InputFormSubmitTest"/>
        </classes>
    </test>

    <test name="macOSVentura-WebKit">
        <parameter name="browserName" value="pw-webkit"/>
        <parameter name="browserVersion" value="latest"/>
        <parameter name="platform" value="Ventura"/>
        <parameter name="testName" value="Playwright101 - macOS Ventura - WebKit"/>
        <classes>
            <class name="com.testmuai.tests.Scenario1SimpleFormDemoTest"/>
            <class name="com.testmuai.tests.Scenario2DragDropSlidersTest"/>
            <class name="com.testmuai.tests.Scenario3InputFormSubmitTest"/>
        </classes>
    </test>
</suite>
